<?xml version="1.0" encoding="UTF-8"?>
<Database name="HomeStay">
    <Description>Sơ đồ cấu trúc cơ sở dữ liệu HomeStay (Bao gồm cấu trúc bảng, mối quan hệ và dữ liệu mẫu)</Description>
    
    <Tables>
        <!-- LEVEL 0: Các bảng gốc (không chứa khóa ngoại) -->
        <Table name="TaiKhoan">
            <Description>Lưu trữ thông tin tài khoản người dùng đăng nhập hệ thống</Description>
            <Columns>
                <Column name="MaTK" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã tài khoản tự sinh"/>
                <Column name="Username" type="VARCHAR(50)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Tên đăng nhập"/>
                <Column name="Password" type="VARCHAR(255)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Mật khẩu đã mã hóa"/>
                <Column name="VaiTro" type="VARCHAR(20)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Vai trò hệ thống (Admin, QuanLy, Sale, KeToan, Khach)"/>
                <Column name="TrangThai" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Trạng thái tài khoản (1: Hoạt động, 0: Bị khóa)"/>
                <Column name="NgayTao" type="DATE" isPrimaryKey="false" isForeignKey="false" isNullable="true" default="CURRENT_DATE" description="Ngày khởi tạo tài khoản"/>
                <Column name="LanDangNhapCuoi" type="TIMESTAMP" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Thời gian đăng nhập gần nhất"/>
                <Column name="Token" type="VARCHAR(255)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Token xác thực hoặc khôi phục"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaTK">1</Value>
                    <Value column="Username">admin</Value>
                    <Value column="Password">123</Value>
                    <Value column="VaiTro">Admin</Value>
                    <Value column="TrangThai">1</Value>
                </Row>
                <Row>
                    <Value column="MaTK">2</Value>
                    <Value column="Username">quanly</Value>
                    <Value column="Password">123</Value>
                    <Value column="VaiTro">QuanLy</Value>
                    <Value column="TrangThai">1</Value>
                </Row>
                <Row>
                    <Value column="MaTK">3</Value>
                    <Value column="Username">nvsale</Value>
                    <Value column="Password">123</Value>
                    <Value column="VaiTro">Sale</Value>
                    <Value column="TrangThai">1</Value>
                </Row>
                <Row>
                    <Value column="MaTK">4</Value>
                    <Value column="Username">ketoan</Value>
                    <Value column="Password">123</Value>
                    <Value column="VaiTro">KeToan</Value>
                    <Value column="TrangThai">1</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="LoaiPhong">
            <Description>Danh mục các loại phòng thuê</Description>
            <Columns>
                <Column name="MaLoai" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã loại phòng"/>
                <Column name="TenLoai" type="VARCHAR(50)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Tên loại phòng (Standard, VIP, Studio,...)"/>
                <Column name="GiaTien" type="DECIMAL(10,2)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Giá thuê loại phòng"/>
                <Column name="SucChua" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Sức chứa người tối đa"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaLoai">1</Value>
                    <Value column="TenLoai">Standard</Value>
                    <Value column="GiaTien">500000.00</Value>
                    <Value column="SucChua">2</Value>
                </Row>
                <Row>
                    <Value column="MaLoai">2</Value>
                    <Value column="TenLoai">Thường 4 người</Value>
                    <Value column="GiaTien">2500000.00</Value>
                    <Value column="SucChua">4</Value>
                </Row>
                <Row>
                    <Value column="MaLoai">3</Value>
                    <Value column="TenLoai">Cao cấp 2 người</Value>
                    <Value column="GiaTien">3800000.00</Value>
                    <Value column="SucChua">2</Value>
                </Row>
                <Row>
                    <Value column="MaLoai">4</Value>
                    <Value column="TenLoai">Studio 1 người</Value>
                    <Value column="GiaTien">8500000.00</Value>
                    <Value column="SucChua">1</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="DichVuPhong">
            <Description>Danh mục tiện ích và dịch vụ đi kèm sẵn trong phòng</Description>
            <Columns>
                <Column name="MaDVP" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã dịch vụ phòng"/>
                <Column name="TenDichVu" type="VARCHAR(100)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Tên dịch vụ tiện ích"/>
                <Column name="GiaTien" type="DECIMAL(10,2)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Đơn giá dịch vụ"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaDVP">1</Value>
                    <Value column="TenDichVu">Wi-Fi Tốc độ cao</Value>
                    <Value column="GiaTien">100000.00</Value>
                </Row>
                <Row>
                    <Value column="MaDVP">2</Value>
                    <Value column="TenDichVu">Máy lạnh Inverter</Value>
                    <Value column="GiaTien">0.00</Value>
                </Row>
                <Row>
                    <Value column="MaDVP">3</Value>
                    <Value column="TenDichVu">Tủ cá nhân Khóa từ</Value>
                    <Value column="GiaTien">0.00</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="DichVuKhac">
            <Description>Dịch vụ tùy chọn phát sinh (điện, nước, dọn phòng, giặt là,...)</Description>
            <Columns>
                <Column name="MaDV" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã dịch vụ khác"/>
                <Column name="TenDichVu" type="VARCHAR(100)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Tên dịch vụ ngoài"/>
                <Column name="DonGia" type="DECIMAL(10,2)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Đơn giá tính tiền"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaDV">1</Value>
                    <Value column="TenDichVu">Dọn phòng 2 lần/tuần</Value>
                    <Value column="DonGia">150000.00</Value>
                </Row>
            </SampleData>
        </Table>

        <!-- LEVEL 1: Các bảng chứa 1 khóa ngoại trỏ tới bảng gốc -->
        <Table name="NhanVien">
            <Description>Thông tin nhân viên vận hành hệ thống</Description>
            <Columns>
                <Column name="MaNV" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã nhân viên"/>
                <Column name="TenNV" type="VARCHAR(100)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Họ tên nhân viên"/>
                <Column name="ChucVu" type="VARCHAR(50)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Chức vụ đảm nhiệm"/>
                <Column name="MaTK" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Mã tài khoản liên kết"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaNV">1</Value>
                    <Value column="TenNV">Admin</Value>
                    <Value column="ChucVu">Admin</Value>
                    <Value column="MaTK">1</Value>
                </Row>
                <Row>
                    <Value column="MaNV">2</Value>
                    <Value column="TenNV">Quan ly 1</Value>
                    <Value column="ChucVu">Quan Ly</Value>
                    <Value column="MaTK">2</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="KhachHang">
            <Description>Thông tin khách thuê HomeStay</Description>
            <Columns>
                <Column name="MaKH" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã khách hàng"/>
                <Column name="HoTen" type="VARCHAR(100)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Họ tên đầy đủ"/>
                <Column name="CCCD" type="VARCHAR(20)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Số CCCD/Hộ chiếu"/>
                <Column name="SDT" type="VARCHAR(15)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Số điện thoại liên lạc"/>
                <Column name="Email" type="VARCHAR(100)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Địa chỉ email cá nhân"/>
                <Column name="DiaChi" type="VARCHAR(200)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Địa chỉ thường trú"/>
                <Column name="Avatar" type="VARCHAR(255)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Đường dẫn ảnh đại diện"/>
                <Column name="STKNhanCoc" type="VARCHAR(50)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Số tài khoản ngân hàng để nhận lại cọc khi trả phòng"/>
                <Column name="MaTK" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Mã tài khoản liên kết"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaKH">99</Value>
                    <Value column="HoTen">Nguyễn Văn A</Value>
                    <Value column="CCCD">079199000123</Value>
                    <Value column="Email">nguyenvana@gmail.com</Value>
                    <Value column="SDT">0901234567</Value>
                    <Value column="MaTK">1</Value>
                </Row>
                <Row>
                    <Value column="MaKH">1</Value>
                    <Value column="HoTen">khach1</Value>
                    <Value column="CCCD">00000000001</Value>
                    <Value column="Email">khach1@test.com</Value>
                    <Value column="SDT">090000001</Value>
                    <Value column="MaTK">5</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="Phong">
            <Description>Thông tin chi tiết các phòng trong HomeStay</Description>
            <Columns>
                <Column name="MaPhong" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã số phòng"/>
                <Column name="TenPhong" type="VARCHAR(50)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Tên/Số phòng hiển thị"/>
                <Column name="TrangThai" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Trạng thái phòng (1: Trống, 0: Đang thuê,...)"/>
                <Column name="ChiNhanh" type="VARCHAR(100)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Chi nhánh/Vị trí địa lý"/>
                <Column name="TieuChiGioiTinh" type="VARCHAR(20)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Tiêu chí giới tính phòng (Nam, Nữ, Nam/Nữ)"/>
                <Column name="HinhAnh" type="VARCHAR(255)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Đường dẫn hình ảnh phòng"/>
                <Column name="MaLoai" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Liên kết loại phòng"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaPhong">101</Value>
                    <Value column="TenPhong">Studio Cao Cấp - T12</Value>
                    <Value column="TrangThai">1</Value>
                    <Value column="ChiNhanh">Quận 1, TP. HCM</Value>
                    <Value column="TieuChiGioiTinh">Nam/Nữ</Value>
                    <Value column="MaLoai">4</Value>
                </Row>
                <Row>
                    <Value column="MaPhong">102</Value>
                    <Value column="TenPhong">Căn Hộ Deluxe - B04</Value>
                    <Value column="TrangThai">1</Value>
                    <Value column="ChiNhanh">Quận 3, TP. HCM</Value>
                    <Value column="TieuChiGioiTinh">Nam/Nữ</Value>
                    <Value column="MaLoai">2</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="ChiTietDichVuPhong">
            <Description>Bảng trung gian n-n giữa LoaiPhong và DichVuPhong</Description>
            <Columns>
                <Column name="MaLoai" type="INT" isPrimaryKey="true" isForeignKey="true" isNullable="false" description="Liên kết loại phòng"/>
                <Column name="MaDVP" type="INT" isPrimaryKey="true" isForeignKey="true" isNullable="false" description="Liên kết dịch vụ phòng"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaLoai">2</Value>
                    <Value column="MaDVP">1</Value>
                </Row>
                <Row>
                    <Value column="MaLoai">2</Value>
                    <Value column="MaDVP">2</Value>
                </Row>
            </SampleData>
        </Table>

        <!-- LEVEL 2: Chi tiết tài sản, lịch hẹn & đặt cọc -->
        <Table name="Giuong">
            <Description>Chi tiết các giường ngủ trong từng phòng (hỗ trợ mô hình KTX/Shared Room)</Description>
            <Columns>
                <Column name="MaGiuong" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã giường"/>
                <Column name="TenGiuong" type="VARCHAR(50)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Ký hiệu tên giường (Giường A, Giường B,...)"/>
                <Column name="TrangThai" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Trạng thái giường (1: Trống, 0: Đã có khách thuê)"/>
                <Column name="MaPhong" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Liên kết phòng chứa giường"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaGiuong">1</Value>
                    <Value column="TenGiuong">Giường 1</Value>
                    <Value column="TrangThai">1</Value>
                    <Value column="MaPhong">102</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="PhieuDangKyHen">
            <Description>Phiếu hẹn xem phòng trực tiếp của khách hàng</Description>
            <Columns>
                <Column name="MaPhieu" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã phiếu hẹn"/>
                <Column name="SoNguoi" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Số lượng người xem phòng cùng"/>
                <Column name="NgayHen" type="TIMESTAMP" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Ngày hẹn xem phòng"/>
                <Column name="GioHen" type="TIME" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Giờ hẹn xem phòng"/>
                <Column name="GhiChu" type="VARCHAR(255)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Ghi chú thêm của khách"/>
                <Column name="TrangThai" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Trạng thái lịch hẹn (0: Chờ duyệt, 1: Đã duyệt, 2: Đã hủy)"/>
                <Column name="MaKH" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Khách hàng đặt lịch hẹn"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaPhieu">1</Value>
                    <Value column="SoNguoi">2</Value>
                    <Value column="NgayHen">2026-07-15 09:30:00</Value>
                    <Value column="GioHen">09:30:00</Value>
                    <Value column="GhiChu">Xin xem kỹ phòng bếp và vệ sinh</Value>
                    <Value column="TrangThai">1</Value>
                    <Value column="MaKH">99</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="CT_LichHen">
            <Description>Chi tiết danh sách các phòng khách hàng muốn hẹn xem trong một phiếu hẹn</Description>
            <Columns>
                <Column name="MaPhieu" type="INT" isPrimaryKey="true" isForeignKey="true" isNullable="false" description="Mã phiếu hẹn xem"/>
                <Column name="MaPhong" type="INT" isPrimaryKey="true" isForeignKey="true" isNullable="false" description="Mã phòng quan tâm"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaPhieu">1</Value>
                    <Value column="MaPhong">101</Value>
                </Row>
                <Row>
                    <Value column="MaPhieu">1</Value>
                    <Value column="MaPhong">102</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="PhieuDatCoc">
            <Description>Lưu thông tin đặt cọc giữ chỗ phòng của khách hàng</Description>
            <Columns>
                <Column name="MaCoc" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã giao dịch đặt cọc"/>
                <Column name="SoTien" type="DECIMAL(10,2)" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Số tiền đặt cọc giữ phòng"/>
                <Column name="NgayCoc" type="DATE" isPrimaryKey="false" isForeignKey="false" isNullable="true" default="CURRENT_DATE" description="Ngày tiến hành đặt cọc"/>
                <Column name="TrangThai" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Trạng thái cọc (0: Chưa thanh toán, 1: Đã đặt cọc, 2: Đã hoàn cọc/hết hạn)"/>
                <Column name="MaGiaoDich" type="VARCHAR(100)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Mã giao dịch cổng thanh toán Paypal/VNPAY"/>
                <Column name="PTThanhToan" type="VARCHAR(50)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Phương thức thực hiện thanh toán"/>
                <Column name="MaKH" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Khách hàng đặt cọc"/>
                <Column name="MaPhong" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Phòng được đặt cọc giữ chỗ"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaCoc">1</Value>
                    <Value column="SoTien">4000000.00</Value>
                    <Value column="NgayCoc">2026-07-15</Value>
                    <Value column="TrangThai">1</Value>
                    <Value column="MaKH">1</Value>
                    <Value column="MaPhong">102</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="ChiSoDienNuoc">
            <Description>Ghi nhận chỉ số điện nước định kỳ hàng tháng của từng phòng</Description>
            <Columns>
                <Column name="MaCS" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã chỉ số điện nước"/>
                <Column name="Thang" type="VARCHAR(7)" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Tháng ghi nhận chỉ số (Định dạng YYYY-MM)"/>
                <Column name="CSDienCu" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Chỉ số điện cũ đầu tháng"/>
                <Column name="CSDienMoi" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Chỉ số điện mới cuối tháng"/>
                <Column name="CSNuocCu" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Chỉ số nước cũ đầu tháng"/>
                <Column name="CSNuocMoi" type="INT" isPrimaryKey="false" isForeignKey="false" isNullable="true" description="Chỉ số nước mới cuối tháng"/>
                <Column name="MaPhong" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Mã phòng ghi nhận chỉ số"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaCS">1</Value>
                    <Value column="Thang">2026-07</Value>
                    <Value column="CSDienCu">100</Value>
                    <Value column="CSDienMoi">250</Value>
                    <Value column="CSNuocCu">10</Value>
                    <Value column="CSNuocMoi">25</Value>
                    <Value column="MaPhong">1</Value>
                </Row>
            </SampleData>
        </Table>

        <!-- LEVEL 3: Hợp đồng & Các chi tiết ràng buộc theo hợp đồng -->
        <Table name="HopDong">
            <Description>Hợp đồng thuê phòng ký kết giữa khách hàng và HomeStay</Description>
            <Columns>
                <Column name="MaHD" type="SERIAL" isPrimaryKey="true" isForeignKey="false" isNullable="false" description="Mã hợp đồng thuê phòng"/>
                <Column name="NgayKy" type="DATE" isPrimaryKey="false" isForeignKey="false" isNullable="true" default="CURRENT_DATE" description="Ngày ký kết hợp đồng"/>
                <Column name="NgayHetHan" type="DATE" isPrimaryKey="false" isForeignKey="false" isNullable="false" description="Ngày hợp đồng hết hiệu lực"/>
                <Column name="MaKHDaiDien" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Khách hàng đại diện ký tên"/>
                <Column name="MaNV" type="INT" isPrimaryKey="false" isForeignKey="true" isNullable="false" description="Nhân viên lập hợp đồng"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaHD">1001</Value>
                    <Value column="NgayKy">2026-07-15</Value>
                    <Value column="NgayHetHan">2026-12-31</Value>
                    <Value column="MaKHDaiDien">1</Value>
                    <Value column="MaNV">1</Value>
                </Row>
                <Row>
                    <Value column="MaHD">9999</Value>
                    <Value column="NgayKy">2026-07-15</Value>
                    <Value column="NgayHetHan">2026-12-31</Value>
                    <Value column="MaKHDaiDien">99</Value>
                    <Value column="MaNV">1</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="ThanhVienThue">
            <Description>Danh sách khách thuê cùng phòng/sử dụng chung hợp đồng</Description>
            <Columns>
                <Column name="MaHD" type="INT" isPrimaryKey="true" isForeignKey="true" isNullable="false" description="Mã hợp đồng thuê"/>
                <Column name="MaKH" type="INT" isPrimaryKey="true" isForeignKey="true" isNullable="false" description="Khách thuê cùng phòng"/>
            </Columns>
            <SampleData>
                <Row>
                    <Value column="MaHD">9999</Value>
                    <Value column="MaKH">99</Value>
                </Row>
            </SampleData>
        </Table>

        <Table name="ChiTietGiuong">
            <Description>Liên kết bàn giao các giường cụ thể trong hợp đồng thuê</Description>
